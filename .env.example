JWT_SECRET= 
GEMINI_API_KEY=
# ชื่อโมเดล Gemini (ถ้าไม่ตั้ง ใช้ gemini-3.5-flash)
GEMINI_MODEL=

# --- Initial Admin Bootstrap (optional) ---
# ถ้าไม่ตั้งค่าเหล่านี้ ระบบจะ generate รหัสผ่านสุ่มให้อัตโนมัติตอน startup
# และ print ออกทาง console log ครั้งเดียว (ต้อง copy ไปใช้แล้วเปลี่ยนทันที)
# แนะนำให้ตั้งค่าเองก่อน deploy จริงเพื่อควบคุม credential ตั้งแต่ต้น
INITIAL_ADMIN_EMPLOYEE_ID= 
INITIAL_ADMIN_PASSWORD= 
INITIAL_ADMIN_NAME= 
INITIAL_ADMIN_EMAIL= 
INITIAL_ADMIN_PHONE=
INITIAL_ADMIN_DEPARTMENT_ID=
INITIAL_ADMIN_POSITION=

# --- PostgreSQL (PERSIST-01C) ---
# Server ต่อฐาน km_rmp ด้วย Role km_app ตอนเริ่ม — ต่อไม่ได้หรือไม่ได้ตั้ง DB_PASSWORD = Server ไม่เปิด
# ค่าเริ่มต้นตามด้านล่าง; DB_PASSWORD ต้องใส่เองใน .env (รหัสผ่านที่ตั้งด้วย \password km_app ตาม db/README.md)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=km_rmp
DB_USER=km_app
DB_PASSWORD=